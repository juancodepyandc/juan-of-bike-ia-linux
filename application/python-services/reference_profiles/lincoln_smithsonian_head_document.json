        "edanEntry": "{\"id\":\"edanmdm-npg_NPG.71.26\",\"title\":\"Abraham Lincoln\",\"unitCode\":\"NPG\",\"linkedId\":\"0\",\"type\":\"edanmdm\",\"url\":\"edanmdm:npg_NPG.71.26\",\"content\":{\"descriptiveNonRepeating\":{\"record_ID\":\"npg_NPG.71.26\",\"online_media\":{\"mediaCount\":\"1\",\"media\":[{\"thumbnail\":\"http://ids.si.edu/ids/deliveryService?id=NPG-NPG_71_26Lincolnv1_d1\",\"idsId\":\"NPG-NPG_71_26Lincolnv1_d1\",\"usage\":{\"access\":\"Usage conditions apply\",\"text\":\"\"},\"type\":\"Images\",\"content\":\"http://ids.si.edu/ids/deliveryService?id=NPG-NPG_71_26Lincolnv1_d1\"}]},\"unit_code\":\"NPG\",\"title_sort\":\"ABRAHAM LINCOLN\",\"record_link\":\"http://npg.si.edu/object/npg_NPG.71.26\",\"title\":{\"label\":\"Title\",\"content\":\"Abraham Lincoln\"},\"metadata_usage\":{\"access\":\"Usage conditions apply\",\"text\":\"\"},\"data_source\":\"National Portrait Gallery\"},\"indexedStructured\":{\"date\":[\"1920s\",\"1860s\"],\"exhibition\":[{\"exhibitionTitle\":\"America's Presidents (Reinstallation September 2017)\",\"building\":\"NPG\",\"room\":\"South Gallery 240\"}],\"object_type\":[\"Sculpture (visual work)\"],\"geoLocation\":[{\"L1\":{\"type\":\"Continent\",\"content\":\" North America\"},\"L2\":{\"type\":\"Country\",\"content\":\"United States of America\"}},{\"L1\":{\"type\":\"Continent\",\"content\":\" North America\"},\"L2\":{\"type\":\"Country\",\"content\":\"United States of America\"}},{\"L1\":{\"type\":\"Continent\",\"content\":\" North America\"},\"L2\":{\"type\":\"Country\",\"content\":\"United States of America\"},\"L3\":{\"type\":\"State\",\"content\":\"Illinois\"}},{\"L1\":{\"type\":\"Continent\",\"content\":\" North America\"},\"L2\":{\"type\":\"Country\",\"content\":\"United States of America\"}}],\"name\":[\"Lincoln, Abraham\",\"Mills, Clark\"],\"onPhysicalExhibit\":[\"Yes\"],\"topic\":[\"Business and Finance\",\"Legislators\",\"Soldiers\",\"Merchants\",\"Businessperson\",\"Life mask\",\"Masks\",\"Reformers\",\"Crafts and Trades\",\"Public officers\",\"Presidents\",\"Military\",\"Activism\",\"Congressmen\",\"Government\",\"Society and social change\",\"Portraits\",\"Facial Hair\",\"Lawyers\",\"Ecology\",\"Boat builder\",\"Law and Law Enforcement\",\"Surveyors\",\"Men\",\"Senators\",\"Politics\",\"Beards\",\"Postmasters\"],\"place\":[\"United States\",\"Illinois\"],\"online_media_type\":[\"Images\"]},\"freetext\":{\"setName\":[{\"label\":\"See more items in\",\"content\":\"National Portrait Gallery Collection\"},{\"label\":\"Exhibition\",\"content\":\"America's Presidents (Reinstallation September 2017)\"},{\"label\":\"On View\",\"content\":\"NPG, South Gallery 240\"}],\"date\":[{\"label\":\"Date\",\"content\":\"c. 1917 cast after 1865 original\"}],\"identifier\":[{\"label\":\"Object number\",\"content\":\"NPG.71.26\"}],\"notes\":[{\"label\":\"Exhibition Label\",\"content\":\"Born Hardin County, Kentucky\"},{\"label\":\"Exhibition Label\",\"content\":\"Looking at this cast of Abraham Lincoln’s face, which appears gaunt and careworn, one may think that it is a death mask, but in fact, it was taken from life on February 11, 1865, by sculptor Clark Mills. Life masks were popular in the nineteenth century because they created a duplicate of the subject’s features. A friend of Lincoln’s commented on the mask’s ability to portray “one on whom sorrow and care had done their worst.”\"},{\"label\":\"Exhibition Label\",\"content\":\"Nacido en el condado de Hardin, Kentucky\"},{\"label\":\"Exhibition Label\",\"content\":\"Observando esta imagen del rostro de Abraham Lincoln, en la que aparece consumido y agobiado, uno puede pensar que se trata de una máscara funeraria, pero de hecho fue tomada en vida el 11 de febrero de 1865 por el escultor Clark Mills. Los moldes del rostro eran populares en el siglo XIX porque creaban un duplicado de las facciones del modelo. Un amigo de Lincoln comentó que la máscara lograba mostrar a “alguien en quien el dolor y la preocupación habían causado devastación”.\"},{\"label\":\"Provenance\",\"content\":\"National Museum of History and Technology (now National Museum of American History); transferred to NPG 1971\"}],\"creditLine\":[{\"label\":\"Credit Line\",\"content\":\"National Portrait Gallery, Smithsonian Institution; transfer from the National Museum of American History\"}],\"name\":[{\"label\":\"Cast after\",\"content\":\"Clark Mills, 13 Dec 1810 - 12 Jan 1883\"},{\"label\":\"Sitter\",\"content\":\"Abraham Lincoln, 12 Feb 1809 - 15 Apr 1865\"}],\"topic\":[{\"label\":\"Topic\",\"content\":\"Personal Attribute\\\\Facial Hair\\\\Beard\"},{\"label\":\"Topic\",\"content\":\"Mask\\\\Life mask\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Male\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Law and Law Enforcement\\\\Lawyer\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Military\\\\Soldier\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Politics and Government\\\\President of US\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Society and Social Change\\\\Reformer\\\\Environmentalist\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Business and Finance\\\\Businessperson\\\\Merchant\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Politics and Government\\\\US Congressman\\\\Illinois\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Politics and Government\\\\Government Official\\\\Surveyor\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Politics and Government\\\\State Senator\\\\Illinois\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Politics and Government\\\\Government Official\\\\Postmaster\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Crafts and Trades\\\\Boat builder\"},{\"label\":\"Topic\",\"content\":\"Portrait\"}],\"physicalDescription\":[{\"label\":\"Medium\",\"content\":\"Plaster\"},{\"label\":\"Dimensions\",\"content\":\"17.1 x 20.3 x 29.8cm (6 3/4 x 8 x 11 3/4\\\")\"}],\"dataSource\":[{\"label\":\"Data Source\",\"content\":\"National Portrait Gallery\"}],\"objectType\":[{\"label\":\"Type\",\"content\":\"Sculpture\"}]}},\"hash\":\"b69693feb8a1bf198d173be1c369a572481ca608\",\"docSignature\":\"b113c422923ce85ed7f4fafe69a3fcd33383c008_caceaf231e516943ba70bb6344623e03\",\"timestamp\":\"1578993695\",\"lastTimeUpdated\":\"1578993352\",\"status\":0,\"version\":\"\",\"publicSearch\":true,\"linkedContent\":{}}",
