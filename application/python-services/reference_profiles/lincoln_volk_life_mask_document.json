      "annotations": [
        {
          "id": "nHiCDzDmz8wu",
          "title": "The Man behind the Mask",
          "lead": "Lincoln’s life mask offers a window into his thoughts as he begins his presidency. Given what you know about Lincoln, what could he be thinking about as this mask was being created?",
          "marker": "1",
          "articleId": "blHTINSA1xvZ",
          "style": "Circle",
          "position": [
            46.1908858,
            80.6948155,
            16.6842826
          ],
          "direction": [
            0.5695276,
            0.5505788,
            0.6103289
          ],
          "scale": 10,
          "color": [
            0,
            0.61,
            0.87
          ]
        },
        {
          "id": "1ihNqUFUtC3k",
          "title": "Process",
          "lead": "“There is the animal himself.” This was Lincoln’s comment upon seeing the bust, which was made using the life mask. The process of creating a mask could be an uncomfortable one. It took more than an hour before this mold was ready to be removed from Lincoln’s face, taking a few hairs with it.",
          "marker": "2",
          "articleId": "KQ9nPcWFxeJU",
          "style": "Circle",
          "position": [
            46.0643207,
            -42.4701632,
            21.5957317
          ],
          "direction": [
            0.6237648,
            -0.516747,
            0.5864214
          ],
          "scale": 10,
          "color": [
            0,
            0.61,
            0.87
          ]
        },
        {
          "id": "vNcpN1u1KL09",
          "title": "Age",
          "lead": "Do you think this is a representation of Lincoln at the beginning or end of the Civil War? Why do you think that?",
          "marker": "3",
          "style": "Circle",
          "position": [
            51.6002237,
            -30.6084495,
            26.2779741
          ],
          "direction": [
            0.5570706,
            -0.5364046,
            0.6339893
          ],
          "scale": 10,
          "color": [
            0,
            0.61,
            0.87
          ]
        },
        {
          "id": "EYKtirJybSGN",
          "title": "Purpose",
          "lead": "Abraham Lincoln was the first president to use the new art of photography for political purposes. Photographs, paintings, and sculptures of him were created both before and during his presidency. Look closely at the mask. What qualities does the mask have that a photograph or a painting does not?",
          "marker": "4",
          "articleId": "KypHQlL3cYo3",
          "style": "Circle",
          "position": [
            -79.1729977,
            28.349576,
            -40.3499608
          ],
          "direction": [
            -0.966084,
            -0.2104233,
            0.1496785
          ],
          "scale": 10,
          "color": [
            0,
            0.61,
            0.87
          ]
        },
        {
          "id": "XP2jOz6rDAqu",
          "title": "The Artist",
          "lead": "This mask was the first life portrait of Lincoln in any medium except photography. The artist, Leonard Wells Volk, continued to use this mask as the model for various sculptures of Lincoln for thirty-two years after the initial sitting in 1860.",
          "marker": "5",
          "articleId": "q6H6PYg4nbmL",
          "style": "Circle",
          "position": [
            -61.4895673,
            -14.4359326,
            21.718315
          ],
          "direction": [
            -0.8329221,
            0.0188675,
            0.5530685
          ],
          "scale": 10,
          "color": [
            0,
            0.61,
            0.87
          ]
        },
        {
          "id": "i0xA6urnnyYU",
          "title": "The Civil War",
          "lead": "As Lincoln looks out, frozen in time with every line and wrinkle on his face recorded, we cannot help but wonder if he knew of the enormity of the tumultuous task he would soon face. When you look at Lincoln’s life mask, what clues do you see that speak to his intensity of purpose and strong belief in keeping the union united?",
          "marker": "6",
          "articleId": "dch924QLwCen",
          "style": "Circle",
          "position": [
            -61.6890112,
            22.9942154,
            14.0996267
          ],
          "direction": [
            -0.9758141,
            0.1387638,
            0.1689128
          ],
          "scale": 10,
          "color": [
            0,
            0.61,
            0.87
          ]
        },
        {
          "id": "PUE2LwrsS8TG",
          "title": "Lincoln's Profile",
          "lead": "Examine the mask by comparing the left and right profiles. What similarities and differences do you see?",
          "marker": "7",
          "style": "Circle",
          "position": [
            -1.4683868,
            57.8776121,
            47.1874209
          ],
          "direction": [
