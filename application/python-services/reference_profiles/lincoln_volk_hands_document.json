      "collection": {
        "edanRecordId": "edanmdm:npg_S_NPG.71.6",
        "edanEntry": "{\"id\":\"edanmdm-npg_S_NPG.71.6\",\"title\":\"Abraham Lincoln\",\"unitCode\":\"NPG\",\"linkedId\":\"0\",\"type\":\"edanmdm\",\"url\":\"edanmdm:npg_S_NPG.71.6\",\"content\":{\"descriptiveNonRepeating\":{\"record_ID\":\"npg_S_NPG.71.6\",\"online_media\":{\"mediaCount\":\"1\",\"media\":[{\"thumbnail\":\"https://npg.si.edu/media/7110012A_1.jpg\",\"idsId\":\"https://npg.si.edu/media/7110012A_1.jpg\",\"type\":\"Images\",\"content\":\"https://npg.si.edu/media/7110012A_1.jpg\"}]},\"unit_code\":\"NPG\",\"title_sort\":\"ABRAHAM LINCOLN\",\"record_link\":\"http://npg.si.edu/object/npg_S_NPG.71.6\",\"title\":{\"label\":\"Title\",\"content\":\"Abraham Lincoln\"},\"data_source\":\"National Portrait Gallery\"},\"indexedStructured\":{\"date\":[\"1860s\"],\"exhibition\":[{\"exhibitionTitle\":\"America's Presidents (Reinstallation September 2017)\",\"building\":\"NPG\",\"room\":\"South Gallery 240\"}],\"object_type\":[\"Sculpture (visual work)\"],\"geoLocation\":[{\"L1\":{\"type\":\"Continent\",\"content\":\" North America\"},\"L2\":{\"type\":\"Country\",\"content\":\"United States of America\"}},{\"L1\":{\"type\":\"Continent\",\"content\":\" North America\"},\"L2\":{\"type\":\"Country\",\"content\":\"United States of America\"}},{\"L1\":{\"type\":\"Continent\",\"content\":\" North America\"},\"L2\":{\"type\":\"Country\",\"content\":\"United States of America\"},\"L3\":{\"type\":\"State\",\"content\":\"Illinois\"}},{\"L1\":{\"type\":\"Continent\",\"content\":\" North America\"},\"L2\":{\"type\":\"Country\",\"content\":\"United States of America\"}}],\"name\":[\"Lincoln, Abraham\",\"Volk, Leonard Wells\"],\"onPhysicalExhibit\":[\"Yes\"],\"topic\":[\"Business and Finance\",\"Legislators\",\"Soldiers\",\"Activism\",\"Merchants\",\"Congressmen\",\"Government\",\"Society and social change\",\"Businessperson\",\"Portraits\",\"Lawyers\",\"Ecology\",\"Reformers\",\"Boat builder\",\"Law and Law Enforcement\",\"Crafts and Trades\",\"Surveyors\",\"Men\",\"Senators\",\"Public officers\",\"Politics\",\"Presidents\",\"Military\",\"Postmasters\"],\"place\":[\"United States\",\"Illinois\"],\"online_media_type\":[\"Images\"]},\"freetext\":{\"setName\":[{\"label\":\"See more items in\",\"content\":\"National Portrait Gallery Collection\"},{\"label\":\"Exhibition\",\"content\":\"America's Presidents (Reinstallation September 2017)\"},{\"label\":\"On View\",\"content\":\"NPG, South Gallery 240\"}],\"date\":[{\"label\":\"Date\",\"content\":\"c. 1917 cast after 1860 original\"}],\"identifier\":[{\"label\":\"Object number\",\"content\":\"S/NPG.71.6\"}],\"notes\":[{\"label\":\"Exhibition Label\",\"content\":\"Abraham Lincoln 1809–1865\"},{\"label\":\"Exhibition Label\",\"content\":\"Born Hardin County, Kentucky\"},{\"label\":\"Exhibition Label\",\"content\":\"Soon after Abraham Lincoln won the Republican presidential nomination, in May of 1860, sculptor Leonard Wells Volk made casts of Lincoln’s hands. The right hand is shown grasping a sawed-off section of a broom handle, which Lincoln obligingly fetched from a shed when the artist suggested that he hold on to something. Lincoln smoothed the edges of the wood, reportedly saying, “I thought I would like to have it nice.” During their session, Volk was already thinking of using these casts, in combination with his recently completed Lincoln bust, to fashion a full-length statue.\"},{\"label\":\"Exhibition Label\",\"content\":\"Nacido en el condado de Hardin, Kentucky\"},{\"label\":\"Exhibition Label\",\"content\":\"Poco después de que Abraham Lincoln obtuviera la nominación a la presidencia por el Partido Republicano, en mayo de 1860, el escultor Leonard Wells Volk hizo moldes de sus manos. La mano derecha aparece agarrando un trozo del mango de una escoba que Lincoln tuvo la gentileza de buscar en un cobertizo cuando el artista sugirió que sujetara algo. Cuando Lincoln empezó a lijar los bordes del trozo de madera, Lincoln contestó: “Pensé que me gustaría más pulido”. Ya durante la sesión Volk estaba planeando utilizar estos moldes, en combinación con el busto de Lincoln recién terminado, para construer una estatua de cuerpo entero.\"}],\"creditLine\":[{\"label\":\"Credit Line\",\"content\":\"National Portrait Gallery, Smithsonian Institution; transfer from the National Museum of American History\"}],\"name\":[{\"label\":\"Cast after\",\"content\":\"Leonard Wells Volk, 1828 - 1895\"},{\"label\":\"Sitter\",\"content\":\"Abraham Lincoln, 12 Feb 1809 - 15 Apr 1865\"}],\"topic\":[{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Male\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Law and Law Enforcement\\\\Lawyer\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Military\\\\Soldier\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Politics and Government\\\\President of US\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Society and Social Change\\\\Reformer\\\\Environmentalist\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Business and Finance\\\\Businessperson\\\\Merchant\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Politics and Government\\\\US Congressman\\\\Illinois\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Politics and Government\\\\Government Official\\\\Surveyor\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Politics and Government\\\\State Senator\\\\Illinois\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Politics and Government\\\\Government Official\\\\Postmaster\"},{\"label\":\"Topic\",\"content\":\"Abraham Lincoln: Crafts and Trades\\\\Boat builder\"},{\"label\":\"Topic\",\"content\":\"Portrait\"}],\"physicalDescription\":[{\"label\":\"Medium\",\"content\":\"Plaster\"},{\"label\":\"Dimensions\",\"content\":\"Proper Left: 7.6 x 11.1 x 17.8cm (3 x 4 3/8 x 7\\\")\"},{\"label\":\"Dimensions\",\"content\":\"Proper Right: 8.9 x 12.7 x 15.2cm (3 1/2 x 5 x 6\\\")\"}],\"dataSource\":[{\"label\":\"Data Source\",\"content\":\"National Portrait Gallery\"}],\"objectType\":[{\"label\":\"Type\",\"content\":\"Sculpture\"}]}},\"hash\":\"14748255ba82d42c0636dfbd7f59949167511030\",\"docSignature\":\"8a1eed1fbca2acd76318a595d226ec2e508758aa_b8848fd15e179bc6ec557ee678e48b5e\",\"timestamp\":\"1557822010\",\"lastTimeUpdated\":\"1557822010\",\"status\":0,\"version\":\"\",\"publicSearch\":true,\"linkedContent\":{}}",
