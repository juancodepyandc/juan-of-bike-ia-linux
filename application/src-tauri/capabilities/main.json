{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Mode libert\u00e9 totale : fenetre principale autoris\u00e9e \u00e0 exec shell, lire/\u00e9crire tout fichier, ouvrir URLs, g\u00e9rer process, sans restriction de chemin. Aucun garde-fou applicatif \u2014 env local priv\u00e9 de Juan.",
  "windows": [
    "main"
  ],
  "local": true,
  "remote": {
    "urls": [
      "http://localhost:1420",
      "http://127.0.0.1:1420"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:app:default",
    "core:webview:default",
    "core:window:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "http:default",
    "shell:default",
    "shell:allow-open",
    "process:default",
    "process:allow-exit",
    "process:allow-restart",
    "dialog:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/AuroraIA"
        },
        {
          "path": "$HOME/AuroraIA/**"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$TEMP"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$HOME/Desktop"
        },
        {
          "path": "$HOME/Desktop/**"
        }
      ]
    },
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging"
  ]
}
