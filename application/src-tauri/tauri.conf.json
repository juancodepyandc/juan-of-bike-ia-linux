{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-v2/main/tooling/cli/schema.json",
  "productName": "juan of bike IA",
  "version": "2.0.0",
  "identifier": "com.juanofbike.ia",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "juan of bike IA",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/Desktop/**",
          "$HOME/Desktop/ia/juan of bike IA/**",
          "$HOME/Desktop/ia/AuroraIA-v2/**",
          "$HOME/Desktop/ia/AuroraIA/**",
          "$TEMP/**",
          "$HOME/AuroraIA/**"
        ]
      },
      "csp": "default-src 'self'; frame-src 'self' http://127.0.0.1:* http://localhost:*; connect-src 'self' http://127.0.0.1:* http://localhost:* https://*; img-src 'self' asset: http://asset.localhost blob: data: http://127.0.0.1:*; media-src 'self' asset: http://asset.localhost blob: data: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "ollama",
          "cmd": "ollama",
          "args": true
        },
        {
          "name": "python",
          "cmd": "python",
          "args": true
        },
        {
          "name": "nvidia-smi",
          "cmd": "nvidia-smi",
          "args": true
        }
      ]
    },
    "fs": {
      "scope": {
        "allow": [
          "$APPDATA/**",
          "$HOME/Desktop/**",
          "$HOME/Desktop/ia/juan of bike IA/**",
          "$HOME/Desktop/ia/AuroraIA-v2/**",
          "$HOME/Desktop/ia/AuroraIA/**",
          "$TEMP/**",
          "$HOME/AuroraIA/**"
        ]
      }
    },
    "http": {
      "scope": {
        "allow": [
          {
            "url": "http://127.0.0.1:*"
          },
          {
            "url": "http://localhost:*"
          },
          {
            "url": "https://*"
          }
        ]
      }
    }
  }
}
