name: Validate Aurora agent system

on:
  pull_request:
    paths:
      - '.claude/agents/**'
      - '.claude/agent-tracker/**'
      - '.claude/hooks/**'
      - 'application/scripts/route_test*.py'
      - 'application/python-services/mesh_*.py'
      - 'application/python-services/auto_*.py'
      - 'application/python-services/subject_kind_extractor.py'
      - 'application/python-services/aurora_3d_viewer.py'
      - 'application/python-services/test_*.py'
      - 'application/src/services/threeDIntent.ts'
      - 'application/src/services/meshRescue.ts'
      - 'application/src/__tests__/meshRescue.test.ts'
  push:
    branches: [main]
    paths:
      - '.claude/agents/**'
      - '.claude/agent-tracker/**'
      - '.claude/hooks/**'
      - 'application/scripts/route_test*.py'
      - 'application/python-services/mesh_*.py'
      - 'application/python-services/auto_*.py'
      - 'application/python-services/subject_kind_extractor.py'
      - 'application/python-services/aurora_3d_viewer.py'
      - 'application/python-services/test_*.py'
      - 'application/src/services/threeDIntent.ts'
      - 'application/src/services/meshRescue.ts'
      - 'application/src/__tests__/meshRescue.test.ts'

jobs:
  lint-python:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install Python deps used by the rescue toolchain
        run: |
          python -m pip install --upgrade pip
          # Minimum surface for the unit tests; full Aurora deps are heavier.
          python -m pip install trimesh numpy pillow

      - name: Validate frontmatter + tracker coherence
        run: python .claude/hooks/validate_agents.py

      - name: Compile-check all hooks
        run: |
          python -m py_compile \
            .claude/hooks/track_agent_dispatch.py \
            .claude/hooks/record_last_commit.py \
            .claude/hooks/session_start_status.py \
            .claude/hooks/precompact_tracker_summary.py \
            .claude/hooks/prompt_routing_hint.py \
            .claude/hooks/validate_agents.py \
            .claude/hooks/aurora_dashboard.py \
            .claude/hooks/aurora_selftest.py \
            .claude/hooks/agent_metrics.py \
            .claude/hooks/gen_changelog.py

      - name: Hook unit tests (15)
        run: python .claude/hooks/test_hooks.py

      - name: Route test parity (13)
        run: python application/scripts/test_route_test.py

      - name: Mesh quality scorer tests (8)
        run: python application/python-services/test_mesh_quality_score.py

      - name: Auto-validate tests (17)
        run: python application/python-services/test_auto_validate_mesh.py

      - name: Color diagnostic tests (4)
        run: python application/python-services/test_mesh_color_diagnostic.py

      - name: Bake vertex colors tests (7)
        run: python application/python-services/test_bake_vertex_colors.py

      - name: Auto-rescue tests (5)
        run: python application/python-services/test_auto_rescue.py

      - name: Run index tests (11)
        run: python application/python-services/test_mesh_run_index.py

      - name: Batch rescue tests (5)
        run: python application/python-services/test_batch_rescue.py

      - name: Viewer + compare tests (4)
        run: python application/python-services/test_viewer_compare.py

      - name: CHANGELOG drift check
        run: python .claude/hooks/gen_changelog.py --check

  test-typescript:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: meshRescue.ts tests (13)
        run: |
          node --experimental-strip-types --test \
            application/src/__tests__/meshRescue.test.ts
